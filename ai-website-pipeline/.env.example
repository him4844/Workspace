# =============================================================================
#  WPP environment template — docs/12_environment_variables.md
#
#  RULE: every *uncommented* key below is read by `ConfigSchema` in
#  packages/infra/src/config.ts, and every key that schema reads is documented
#  here. `tests/unit/config-env-parity.test.ts` fails the build if either side
#  drifts, so do not add a variable here before the code reads it.
#
#  Values shown are the schema defaults. `scripts/init-repo.sh` copies this file
#  to `.env` unchanged, which means a fresh checkout runs with LLM_PROVIDER=none
#  (no model calls at all) until you pick a route below.
#
#  NODE_ENV=production refuses to boot while SESSION_SECRET, TOKEN_ENCRYPTION_KEY
#  or INTERNAL_API_TOKEN still start with "dev-", while CHANNEL_SIMULATOR_ENABLED
#  is true, or while WEBHOOK_REQUIRE_SIGNATURE is false.
# =============================================================================

# ---- Core ----
NODE_ENV=development
APP_URL=http://localhost:3000
API_PORT=3000
LOG_LEVEL=info
DEFAULT_LOCALE=uz
ORG_NAME=WPP Internal Team
# Not part of ConfigSchema, but loadDotEnv() copies every line of .env into
# process.env, so Node itself still applies this to date formatting.
TZ=UTC

# ---- Database ----
# Only the pglite driver is implemented. DB_DRIVER=postgres now fails fast with
# DB_DRIVER_UNSUPPORTED instead of silently opening an embedded database
# (packages/db/src/client.ts:assertDbDriverSupported).
DB_DRIVER=pglite
PGLITE_DIR=.pglite
# Read by the schema but unused until a Postgres driver exists:
# DATABASE_URL=postgres://wpp:change-me@localhost:5432/wpp

# ---- Auth & crypto (generate real values for anything that is not a laptop) ----
SESSION_SECRET=dev-only-session-secret
# AES-256-GCM key for stored channel tokens (packages/infra/src/crypto.ts).
TOKEN_ENCRYPTION_KEY=dev-only-token-key-change-me
# Bearer token for the internal /api/v1 routes. Compared against the request
# header, so it must be long and random outside development.
INTERNAL_API_TOKEN=dev-internal-token
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-on-first-login

# ---- Instagram / Meta (not needed while CHANNEL_SIMULATOR_ENABLED=true) ----
IG_APP_ID=
IG_APP_SECRET=dev-ig-app-secret
IG_VERIFY_TOKEN=dev-verify-token
IG_GRAPH_BASE=https://graph.instagram.com
IG_BUSINESS_ACCOUNT_ID=
HUMAN_AGENT_TAG_ENABLED=false
CHANNEL_SIMULATOR_ENABLED=true
WEBHOOK_REQUIRE_SIGNATURE=true

# ---- Worker & queue ----
# PGlite is single-process, so with DB_DRIVER=pglite the worker loop is forced
# into the API process regardless of this flag (DECISIONS.md D-022).
EMBEDDED_WORKER=false
WORKER_CONCURRENCY=2
JOB_POLL_INTERVAL_MS=2000
JOB_LEASE_SECONDS=120

# ---- LLM routes (SPEC §51, D-015; per-agent overrides live in DB agent_configs) ----
# none | scripted | openai | openrouter | openai-compatible | anthropic
# 'none' = run without AI (Phase 1 behaviour); 'scripted' = the test persona.
LLM_PROVIDER=none
# Optional id from config/llm-presets.json — makes the free/paid decision explicit
# instead of guessed from the URL: groq-free | gemini-free | openrouter-free |
# ollama-local | scripted | none
LLM_PRESET=
# §58: the pipeline must run at zero cost, so a route that is not a documented
# free tier or a local host is refused.
LLM_FREE_ONLY=true
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Optional per-agent route overrides; unset falls back to LLM_PROVIDER/LLM_MODEL.
REQUIREMENTS_LLM_PROVIDER=
REQUIREMENTS_LLM_MODEL=
SPECIFICATION_LLM_MODEL=
# §20: the Spec Auditor is a second opinion, so it gets its OWN key (a separate
# rate-limit bucket on free tiers) and, where possible, a different model or
# provider than the agent that wrote the specification. Unset falls back to LLM_*.
AUDITOR_LLM_PROVIDER=
AUDITOR_LLM_PRESET=
AUDITOR_LLM_MODEL=
AUDITOR_LLM_API_KEY=
AUDITOR_LLM_BASE_URL=
# Hard daily spend ceiling in USD, enforced before every call (llm-budget.ts).
LLM_DAILY_BUDGET_USD=10
# At most one repair attempt per agent turn (SPEC §4, §40).
AGENT_MAX_REPAIRS=1

# ---- Messaging ----
SEND_RATE_PER_MINUTE=30
WINDOW_WARNING_HOURS=2
ECHO_REPLY_TEMPLATE=Assalomu alaykum! Xabaringiz uchun rahmat — tez orada savollaringizni beraman. (WPP intake)

# =============================================================================
#  PLANNED — NOT READ BY ANY CODE YET (P5 Coding Agent, P6 Code Checker,
#  P7 Team Panel, ops). Kept commented so nobody sets them and assumes they
#  took effect. Move a line above this banner only together with the code that
#  reads it, and add it to ConfigSchema in the same commit.
# =============================================================================
# PANEL_PORT=3100
# PANEL_ALLOWED_ORIGINS=http://localhost:3100
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=30000
# TOTP_ISSUER=WPP
# AUTH_LOGIN_MAX_ATTEMPTS=10
# IG_OAUTH_REDIRECT_URI=
# WORKSPACES_DIR=./data/workspaces
# ARTIFACTS_DIR=./data
# BUILD_INSTALL_TIMEOUT_MS=900000
# BUILD_TIMEOUT_MS=900000
# BUILD_MEM_LIMIT_MB=900
# BUILD_MAX_CONCURRENCY=1
# CHECK_TIMEOUT_MS=1200000
# CHECK_VIEWPORTS=390x844,768x1024,1440x900
# CHECK_AXE=true
# CHECK_LINKS=true
# CHECK_SECURITY=true
# PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright
# NPM_REGISTRY_ALLOWLIST=registry.npmjs.org
# PREVIEW_BASE_URL=http://localhost:3000
# LOOP_SPEC_AUDIT_MAX=3
# LOOP_CODE_CHECK_MAX=3
# LOOP_CLIENT_REVISION_MAX=5
# LOOP_REQUIREMENTS_MAX_QUESTIONS=40
# INACTIVITY_REMINDER_HOURS=24
# INACTIVITY_MAX_REMINDERS=2
# BACKUP_DIR=./backups
# BACKUP_RETENTION_DAYS=30
# SMTP_URL=
# ALERT_WEBHOOK_URL=
# SENTRY_DSN=
# Never re-add these two: the code reads LLM_API_KEY / AUDITOR_LLM_API_KEY and
# LLM_DAILY_BUDGET_USD. Vendor-specific names (OPENAI_API_KEY, ANTHROPIC_API_KEY,
# OPENROUTER_API_KEY, GEMINI_API_KEY_SPARE_1, GROQ_API_KEY_SPARE_1) and
# LLM_FAKE_MODE / LLM_DAILY_SPEND_CAP_USD were documented but never read.
