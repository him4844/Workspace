{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "composite": true,
    "paths": {
      "@wpp/core": ["packages/core/src/index.ts"],
      "@wpp/db": ["packages/db/src/index.ts"],
      "@wpp/agents": ["packages/agents/src/index.ts"],
      "@wpp/channels": ["packages/channels/src/index.ts"],
      "@wpp/infra": ["packages/infra/src/index.ts"]
    }
  }
}
