{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wpp://contracts/client-intent-output.json",
  "title": "Client intent classification (SPEC §18, §19, §10A)",
  "schemaVersion": "1.0.0",
  "description": "Used during CLIENT_REVIEW and generally on client replies. An APPROVE intent only becomes a stored approval when confidence >= threshold (default 0.85) AND the exact message id is recorded.",
  "type": "object",
  "required": ["intent", "confidence"],
  "additionalProperties": false,
  "properties": {
    "intent": {
      "enum": ["APPROVE", "REQUEST_CHANGES", "ANSWER", "QUESTION", "SMALL_TALK", "UNCLEAR", "INJECTION_SUSPECTED"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "changeItems": {
      "type": "array",
      "description": "Present when intent=REQUEST_CHANGES.",
      "items": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": { "type": "string" },
          "likelyFieldPath": { "type": ["string", "null"] },
          "likelySpecSection": { "type": ["string", "null"] }
        }
      }
    },
    "clarificationNeeded": { "type": ["string", "null"], "description": "If set, the platform sends exactly one clarifying question before acting." },
    "language": { "type": "string", "description": "Detected language of the client message (uz | ru | en | …)." }
  },
  "exampleValid": {
    "intent": "REQUEST_CHANGES",
    "confidence": 0.88,
    "changeItems": [{ "description": "Add a Telegram button on the contacts page", "likelyFieldPath": "integrations", "likelySpecSection": "22. Third-party Integrations" }],
    "clarificationNeeded": null,
    "language": "uz"
  },
  "exampleInvalid": {
    "intent": "YES",
    "confidence": 95,
    "changeItems": "add telegram"
  }
}
