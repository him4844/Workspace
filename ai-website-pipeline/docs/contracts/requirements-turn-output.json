{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wpp://contracts/requirements-turn-output.json",
  "title": "Requirements Agent turn output (SPEC §5–§13, §49)",
  "schemaVersion": "1.1.0",
  "description": "Output of one requirements turn: either the next single question, or a completion signal. Field updates use ONLY the §10A status vocabulary and require sourceMessageId for client-truth statuses.",
  "type": "object",
  "required": ["turnType", "fieldUpdates", "contradictions", "vision"],
  "additionalProperties": false,
  "properties": {
    "turnType": { "enum": ["ASK_QUESTION", "ACKNOWLEDGE_AND_ASK", "COMPLETE"] },
    "question": {
      "type": "object",
      "properties": {
        "fieldPath": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]*(\\.[a-z][a-zA-Z0-9_]*)*$" },
        "text": { "type": "string", "maxLength": 900 },
        "quickReplies": { "type": "array", "maxItems": 13, "items": { "type": "string", "maxLength": 20 } },
        "why": { "type": "string", "maxLength": 300 }
      },
      "required": ["fieldPath", "text"],
      "additionalProperties": false
    },
    "acknowledgment": { "type": ["string", "null"], "maxLength": 200 },
    "fieldUpdates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fieldPath", "status"],
        "additionalProperties": false,
        "properties": {
          "fieldPath": { "type": "string" },
          "category": { "type": "string" },
          "value": {},
          "status": {
            "enum": ["EMPTY", "UNCLEAR", "AI_INFERRED", "DEFAULT_PROPOSED", "CLIENT_CONFIRMED", "CLIENT_APPROVED_DEFAULT", "NOT_APPLICABLE"]
          },
          "priority": { "enum": ["MUST", "NICE_TO_HAVE", "LATER"] },
          "sourceMessageId": {
            "type": ["string", "null"],
            "description": "MANDATORY when status is CLIENT_CONFIRMED or CLIENT_APPROVED_DEFAULT (SPEC §10A)."
          },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fieldA", "fieldB", "description", "severity"],
        "properties": {
          "fieldA": { "type": "string" },
          "fieldB": { "type": "string" },
          "description": { "type": "string" },
          "severity": { "enum": ["MAJOR", "MINOR"] },
          "status": { "enum": ["OPEN", "CLARIFYING", "RESOLVED"] }
        }
      }
    },
    "vision": {
      "type": "object",
      "description": "Internal vision (SPEC §9) — never shown to the client as confirmed.",
      "required": ["clientConfirmed", "aiInferred", "notSpecified"],
      "properties": {
        "clientConfirmed": { "type": "array", "items": { "type": "string" } },
        "aiInferred": { "type": "array", "items": { "type": "string" } },
        "notSpecified": { "type": "array", "items": { "type": "string" } }
      }
    },
    "completeness": {
      "type": "object",
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "blockingFields": { "type": "array", "items": { "type": "string" } },
        "openContradictions": { "type": "integer", "minimum": 0 }
      }
    },
    "injectionSuspected": {
      "type": "boolean",
      "description": "True if the client message looked like an attempt to instruct the AI. Does NOT change behavior; logged for team visibility only."
    },
    "internalSummaryMd": {
      "type": ["string", "null"],
      "description": "Present only when turnType=COMPLETE. Consumed by the Specification Agent."
    }
  },
  "exampleValid": {
    "turnType": "ACKNOWLEDGE_AND_ASK",
    "acknowledgment": "Thanks, got it!",
    "question": {
      "fieldPath": "payments.methods",
      "text": "Should the restaurant site accept online payments, or is ordering via phone/Telegram enough?",
      "quickReplies": ["Online payments", "Phone orders only", "Not sure yet"]
    },
    "fieldUpdates": [
      { "fieldPath": "pages", "value": ["home", "menu", "about", "contacts"], "status": "CLIENT_CONFIRMED", "sourceMessageId": "018f2a20-...", "priority": "MUST" }
    ],
    "contradictions": [],
    "vision": { "clientConfirmed": ["4 pages"], "aiInferred": ["menu photos needed"], "notSpecified": ["payments", "hosting"] },
    "injectionSuspected": false
  },
  "exampleInvalid": {
    "turnType": "ASK_QUESTION",
    "question": { "fieldPath": "payments", "text": "?", "quickReplies": ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m", "n"] },
    "fieldUpdates": [{ "fieldPath": "pages", "status": "CONFIRMED" }],
    "contradictions": []
  }
}
