%% Project state machine (source of docs/05_state_machine.md)
stateDiagram-v2
  [*] --> NEW
  NEW --> INTAKE --> REQUIREMENTS_IN_PROGRESS
  REQUIREMENTS_IN_PROGRESS --> REQUIREMENTS_COMPLETE : completeness checked
  REQUIREMENTS_COMPLETE --> SPEC_GENERATING --> CLIENT_REVIEW
  CLIENT_REVIEW --> CLIENT_CHANGES_REQUESTED --> SPEC_GENERATING
  CLIENT_REVIEW --> CLIENT_APPROVED : message id recorded, spec LOCKED
  CLIENT_APPROVED --> SPEC_AUDIT
  SPEC_AUDIT --> READY_FOR_BUILD : PASS
  SPEC_AUDIT --> SPEC_REVISION_REQUIRED : FAIL < 3
  SPEC_AUDIT --> BLOCKED : FAIL = 3
  SPEC_REVISION_REQUIRED --> SPEC_GENERATING
  READY_FOR_BUILD --> BUILDING
  BUILDING --> CODE_AUDIT : build ok
  BUILDING --> FAILED : build unrecoverable
  CODE_AUDIT --> TEAM_REVIEW : PASS
  CODE_AUDIT --> CODE_REVISION_REQUIRED : FAIL < 3
  CODE_AUDIT --> BLOCKED : FAIL = 3 or critical security
  CODE_REVISION_REQUIRED --> BUILDING
  TEAM_REVIEW --> TEAM_REVISION --> BUILDING
  TEAM_REVIEW --> PRICE_PENDING --> DEADLINE_PENDING --> IN_DEVELOPMENT
  IN_DEVELOPMENT --> READY_FOR_DELIVERY --> COMPLETED
  BLOCKED --> REQUIREMENTS_IN_PROGRESS
  BLOCKED --> SPEC_REVISION_REQUIRED
  BLOCKED --> CODE_REVISION_REQUIRED
  FAILED --> BLOCKED
