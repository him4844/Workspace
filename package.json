{
  "name": "wpp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-powered website production pipeline (internal tool). Phase 1: Instagram gateway, conversations, simulator channel, state-machine core.",
  "engines": {
    "node": ">=20.11 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx scripts/migrate.ts",
    "db:reset": "node -e \"require('node:fs').rmSync('.pglite',{recursive:true,force:true})\" && npm run migrate && npm run seed",
    "seed": "tsx scripts/seed.ts",
    "api": "tsx apps/api/src/index.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "dev": "tsx scripts/dev.ts",
    "simulate": "tsx scripts/simulate-conversation.ts",
    "simulate:requirements": "tsx scripts/simulate-requirements.ts",
    "demo:live": "tsx scripts/live-requirements-demo.ts",
    "inspect": "tsx scripts/inspect.ts",
    "verify": "npm run typecheck && npm run test && node scripts/check-docs.mjs",
    "simulate:phase3": "tsx scripts/simulate-phase3.ts",
    "prompt-sizes": "tsx scripts/prompt-size-report.ts",
    "simulate:phase4": "tsx scripts/simulate-phase4.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
