# ---- Core ----
NODE_ENV=development
APP_URL=http://localhost:3000
API_PORT=3000
PANEL_PORT=3100
LOG_LEVEL=debug
TZ=UTC
DEFAULT_LOCALE=uz

# ---- Database (dev: pglite | prod: postgres) ----
DB_DRIVER=pglite
PGLITE_DIR=.pglite
# DATABASE_URL=postgres://wpp:change-me@localhost:5432/wpp
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=30000

# ---- Auth & crypto (generate real values for non-dev!) ----
SESSION_SECRET=dev-only-change-me
TOKEN_ENCRYPTION_KEY=dev-only-change-me-32-bytes-base64
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-on-first-login
TOTP_ISSUER=WPP
AUTH_LOGIN_MAX_ATTEMPTS=10

# ---- Instagram / Meta (not needed while CHANNEL_SIMULATOR_ENABLED=true) ----
IG_APP_ID=
IG_APP_SECRET=
IG_VERIFY_TOKEN=
IG_OAUTH_REDIRECT_URI=
IG_GRAPH_BASE=https://graph.instagram.com
IG_BUSINESS_ACCOUNT_ID=
HUMAN_AGENT_TAG_ENABLED=false
CHANNEL_SIMULATOR_ENABLED=true
WEBHOOK_REQUIRE_SIGNATURE=true

# ---- LLM providers (per-agent overrides live in DB agent_configs) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=
LLM_FAKE_MODE=true
LLM_DAILY_SPEND_CAP_USD=10

# ---- LLM route presets & the Spec Auditor's own route (D-029, D-037) ----
# LLM_PRESET picks a free route from config/llm-presets.json: groq-free | gemini-free | openrouter-free | ollama-local | scripted | none
LLM_PRESET=
# Free-only guard: a route that is not a documented free tier / local host is refused (the platform then runs with no LLM).
LLM_FREE_ONLY=true
LLM_BASE_URL=
LLM_MODEL=

# The Spec Auditor (§20) runs on its own key and model where possible, so the reviewer does not share the writer's quota:
AUDITOR_LLM_PROVIDER=
AUDITOR_LLM_PRESET=
AUDITOR_LLM_BASE_URL=
AUDITOR_LLM_MODEL=
AUDITOR_LLM_API_KEY=
# Spare free-tier keys (optional, same provider): GROQ_API_KEY_SPARE_1, GROQ_API_KEY_SPARE_2
# Google AI Studio (Gemini) free tier — the preset `gemini-free`; keys work as Bearer tokens:
GEMINI_API_KEY_SPARE_1=
# OpenRouter — the preset `openrouter-free`; only `:free` slugs are used (roster rotates weekly):
OPENROUTER_API_KEY=

# ---- Builds & checks ----
WORKSPACES_DIR=./data/workspaces
ARTIFACTS_DIR=./data
BUILD_INSTALL_TIMEOUT_MS=900000
BUILD_TIMEOUT_MS=900000
BUILD_MEM_LIMIT_MB=900
BUILD_MAX_CONCURRENCY=1
CHECK_TIMEOUT_MS=1200000
CHECK_VIEWPORTS=390x844,768x1024,1440x900
CHECK_AXE=true
CHECK_LINKS=true
CHECK_SECURITY=true
PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright
NPM_REGISTRY_ALLOWLIST=registry.npmjs.org
PREVIEW_BASE_URL=http://localhost:3000

# ---- Orchestration & limits (DB config_values override these) ----
# Dev only: with DB_DRIVER=pglite the worker loop is forced into the API process
# (PGlite is single-process). Keep false on PostgreSQL.
EMBEDDED_WORKER=false
WORKER_CONCURRENCY=2
JOB_POLL_INTERVAL_MS=5000
JOB_LEASE_SECONDS=120
LOOP_SPEC_AUDIT_MAX=3
LOOP_CODE_CHECK_MAX=3
LOOP_CLIENT_REVISION_MAX=5
LOOP_REQUIREMENTS_MAX_QUESTIONS=40
INACTIVITY_REMINDER_HOURS=24
INACTIVITY_MAX_REMINDERS=2
SEND_RATE_PER_MINUTE=30
WINDOW_WARNING_HOURS=2

# ---- Ops ----
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
SMTP_URL=
ALERT_WEBHOOK_URL=
SENTRY_DSN=
PANEL_ALLOWED_ORIGINS=http://localhost:3100
